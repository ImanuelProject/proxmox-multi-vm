# Kredensial API Proxmox (Opsional: bisa di-set via Environment Variable TF_VAR_proxmox_api_token)
proxmox_api_token    = "root@pam!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_endpoint     = "https://192.168.1.100:8006/"
proxmox_tls_insecure = true

# Jenis workload: "vm" (Virtual Machine) atau "lxc" (Linux Container)
workload_type = "lxc"
vm_started    = true

# Pengaturan Proxmox Node & Storage
proxmox_node    = "pve"
vm_datastore_id = "local-lvm"
network_bridge  = "vmbr0"
default_tags    = ["terraform", "ansible", "ubuntu"]

# Jaringan Dasar (Sesuaikan dengan subnet jaringan fisik/virtual router Anda)
vm_gateway = "192.168.1.1"
vm_cidr    = 24
dns_servers = ["8.8.8.8", "1.1.1.1"]

# Kredensial VM/LXC
vm_user              = "ubuntu"
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"

# Template File (Sesuaikan dengan ID/Nama file di storage Proxmox Anda)
cloud_image_file_id = "local:import/noble-server-cloudimg-amd64.qcow2"
container_template_file_id = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"

# Spesifikasi Default
vm_defaults = {
  role      = "app"
  cpu_cores = 1
  memory    = 1024
  disk_size = 12
}

# Definisi Cluster Server (Di-tuning untuk Kafka CDC)
vms = {
  web-01 = {
    vm_id     = 101
    vm_ip     = "192.168.1.101"
    role      = "web"
    tags      = ["frontend", "kafka-connect"]
    cpu_cores = 2
    memory    = 2048
  }

  app-01 = {
    vm_id     = 102
    vm_ip     = "192.168.1.102"
    role      = "app"
    tags      = ["backend", "kafka-broker"]
    cpu_cores = 2
    memory    = 2048
  }

  db-01 = {
    vm_id     = 103
    vm_ip     = "192.168.1.103"
    role      = "db"
    tags      = ["database", "postgresql"]
    cpu_cores = 2
    memory    = 2048
  }

  monitoring-01 = {
    vm_id     = 104
    vm_ip     = "192.168.1.104"
    role      = "monitoring"
    tags      = ["ops", "grafana"]
    disk_size = 20
  }

  app-02 = {
    vm_id     = 105
    vm_ip     = "192.168.1.105"
    role      = "app"
    tags      = ["backend", "kafka-broker"]
    cpu_cores = 2
    memory    = 2048
  }
}
